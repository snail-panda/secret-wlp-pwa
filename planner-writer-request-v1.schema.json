{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wlp://schemas/planner-writer-request-v1.schema.json",
  "title": "WLP Planner + Experience Writer Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "requestId",
    "session",
    "learnerSessionState",
    "candidateContext",
    "targetPackets",
    "plannerConstraints"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "planner-writer-v1.request"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "session": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "sessionId",
        "mode",
        "sourceMode",
        "difficulty"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "ai-study"
        },
        "sourceMode": {
          "type": "string",
          "minLength": 1
        },
        "sourceLabel": {
          "type": "string"
        },
        "difficulty": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "learnerSessionState": {
      "type": "object",
      "additionalProperties": true
    },
    "candidateContext": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "candidates"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "targetPackets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object"
      }
    },
    "plannerConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTargets",
        "avoidRecentRouteRepetition",
        "naturalnessGateRequired",
        "targetNeedNotBeExplicit"
      ],
      "properties": {
        "maxTargets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "allowMultiTarget": {
          "type": "boolean"
        },
        "avoidRecentRouteRepetition": {
          "type": "boolean"
        },
        "naturalnessGateRequired": {
          "type": "boolean"
        },
        "targetNeedNotBeExplicit": {
          "type": "boolean"
        }
      }
    }
  }
}