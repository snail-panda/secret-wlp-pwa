{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wlp://schemas/interpreter-router-response-v1.schema.json",
  "title": "WLP Interpreter + Router Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "requestId",
    "sessionId",
    "eventId",
    "interpretation",
    "communicativeInterpretation",
    "evidence",
    "routePatch",
    "profilePatch",
    "diagnosticExemplarCandidate",
    "router",
    "learnerFacingResponse"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "interpreter-router-v1.response"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseClasses",
        "conceptMatched",
        "targetProduced",
        "targetFamilyReached",
        "interpretationConfidence"
      ],
      "properties": {
        "responseClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "exact-target",
              "target-family",
              "natural-neighbor",
              "natural-alternative",
              "partial-concept",
              "form-mismatch",
              "sense-mismatch",
              "register-mismatch",
              "construal-shift",
              "unrelated",
              "uncertain",
              "stt-uncertain"
            ]
          }
        },
        "conceptMatched": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "targetProduced": {
          "type": "boolean"
        },
        "targetFamilyReached": {
          "type": "boolean"
        },
        "naturalAlternativesObserved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "formIssue": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "senseIssue": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "registerIssue": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "interpretationConfidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "communicativeInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageCoreMatched",
        "learnerFocus",
        "experienceFocus",
        "focusRelation",
        "learnerExpressionNatural"
      ],
      "properties": {
        "messageCoreMatched": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "learnerFocus": {
          "type": "string"
        },
        "experienceFocus": {
          "type": "string"
        },
        "focusRelation": {
          "enum": [
            "aligned",
            "overlapping",
            "shifted",
            "conflicting",
            "unclear"
          ]
        },
        "learnerExpressionNatural": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceTypes",
        "observationSummary",
        "profilePromotionAllowed"
      ],
      "properties": {
        "evidenceTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "recognition",
              "cue-based-retrieval",
              "spontaneous-production",
              "context-transfer",
              "sense-transfer",
              "reverse-reconstruction",
              "neighbor-discrimination",
              "free-composition",
              "personal-anchor",
              "form-control",
              "construction-use"
            ]
          }
        },
        "observationSummary": {
          "type": "string",
          "minLength": 4
        },
        "profilePromotionAllowed": {
          "type": "boolean"
        }
      }
    },
    "routePatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "payload"
            ],
            "properties": {
              "action": {
                "enum": [
                  "ADD_EVIDENCE",
                  "ADD_CONNECTION",
                  "STRENGTHEN_CONNECTION",
                  "ADD_NEIGHBOR",
                  "ADD_PERSONAL_ANCHOR",
                  "ADD_FAILED_ROUTE",
                  "ADD_DIAGNOSTIC_EXEMPLAR_CANDIDATE",
                  "ADD_DOMAIN"
                ]
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "expression": {
                    "type": "string"
                  },
                  "relationship": {
                    "type": "string"
                  },
                  "source": {
                    "enum": [
                      "learner-generated",
                      "learner-confirmed",
                      "wlp-source",
                      "ai-suggested",
                      "ai-inferred",
                      "experiment-observed"
                    ]
                  },
                  "context": {
                    "type": "string"
                  },
                  "contexts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "value": {
                    "type": "string"
                  },
                  "anchor": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "confidence": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "persistent": {
                    "type": "boolean"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "direction": {
                    "type": "string"
                  },
                  "evidenceType": {
                    "enum": [
                      "recognition",
                      "cue-based-retrieval",
                      "spontaneous-production",
                      "context-transfer",
                      "sense-transfer",
                      "reverse-reconstruction",
                      "neighbor-discrimination",
                      "free-composition",
                      "personal-anchor",
                      "form-control",
                      "construction-use"
                    ]
                  },
                  "evidenceSummary": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "status": {
                        "type": "string"
                      },
                      "evidenceTypes": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "recognition",
                            "cue-based-retrieval",
                            "spontaneous-production",
                            "context-transfer",
                            "sense-transfer",
                            "reverse-reconstruction",
                            "neighbor-discrimination",
                            "free-composition",
                            "personal-anchor",
                            "form-control",
                            "construction-use"
                          ]
                        }
                      },
                      "observationCount": {
                        "type": "integer"
                      },
                      "distinctContextCount": {
                        "type": "integer"
                      }
                    }
                  },
                  "representativeEvidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "learnerResponse": {
                          "type": "string"
                        },
                        "contextSummary": {
                          "type": "string"
                        },
                        "whyImportant": {
                          "type": "string"
                        },
                        "source": {
                          "enum": [
                            "learner-generated",
                            "learner-confirmed",
                            "wlp-source",
                            "ai-suggested",
                            "ai-inferred",
                            "experiment-observed"
                          ]
                        }
                      }
                    }
                  },
                  "counterEvidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "learnerResponse": {
                          "type": "string"
                        },
                        "contextSummary": {
                          "type": "string"
                        },
                        "whyImportant": {
                          "type": "string"
                        },
                        "source": {
                          "enum": [
                            "learner-generated",
                            "learner-confirmed",
                            "wlp-source",
                            "ai-suggested",
                            "ai-inferred",
                            "experiment-observed"
                          ]
                        }
                      }
                    }
                  },
                  "trajectory": {
                    "type": "string"
                  },
                  "route": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "retain": {
                    "type": "boolean"
                  },
                  "name": {
                    "type": "string"
                  },
                  "domain": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "string"
                  },
                  "learnerResponse": {
                    "type": "string"
                  },
                  "contextSummary": {
                    "type": "string"
                  },
                  "whyImportant": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "profilePatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "payload"
            ],
            "properties": {
              "action": {
                "enum": [
                  "ADD_PROFILE_OBSERVATION",
                  "ADD_STYLE_OBSERVATION",
                  "ADD_CONSTRUCTION_EVIDENCE"
                ]
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "pattern": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "context": {
                    "type": "string"
                  },
                  "source": {
                    "enum": [
                      "learner-generated",
                      "learner-confirmed",
                      "wlp-source",
                      "ai-suggested",
                      "ai-inferred",
                      "experiment-observed"
                    ]
                  },
                  "suggestedConfidence": {
                    "enum": [
                      "hypothesis",
                      "supported",
                      "recurring"
                    ]
                  },
                  "confidence": {
                    "enum": [
                      "hypothesis",
                      "supported",
                      "recurring"
                    ]
                  },
                  "usefulScaffolds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "diagnosticExemplar": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "learnerResponse": {
                        "type": "string"
                      },
                      "contextSummary": {
                        "type": "string"
                      },
                      "whyImportant": {
                        "type": "string"
                      },
                      "source": {
                        "enum": [
                          "learner-generated",
                          "learner-confirmed",
                          "wlp-source",
                          "ai-suggested",
                          "ai-inferred",
                          "experiment-observed"
                        ]
                      }
                    }
                  },
                  "construction": {
                    "type": "string"
                  },
                  "learnerStatus": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "learnerResponse": {
                    "type": "string"
                  },
                  "whyImportant": {
                    "type": "string"
                  },
                  "usefulness": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "retainEvidence": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "diagnosticExemplarCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retain",
        "reason"
      ],
      "properties": {
        "retain": {
          "type": "boolean"
        },
        "type": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "learnerResponse": {
          "type": "string"
        },
        "contextSummary": {
          "type": "string"
        }
      }
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "DEEPEN",
            "BRANCH",
            "TRANSFER",
            "CONTRAST",
            "REVERSE",
            "COMPOSE",
            "PAUSE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 4
        }
      }
    },
    "learnerFacingResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feedback",
        "correctionNeeded",
        "suggestedNaturalForm"
      ],
      "properties": {
        "feedback": {
          "type": "string"
        },
        "correctionNeeded": {
          "type": "boolean"
        },
        "suggestedNaturalForm": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
